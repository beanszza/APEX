# ==============================================================================
# APEX — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env         (macOS/Linux)
#   copy .env.example .env       (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5011

# ------------------------------------------------------------------------------
# PostgreSQL (READ-ONLY — same database as api-scms)
# ------------------------------------------------------------------------------
# Source: Same PostgreSQL instance used by api-scms
# APEX only reads from this database — it never writes.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password


# ------------------------------------------------------------------------------
# Auth / JWT (shared secret with ms-authentication)
# ------------------------------------------------------------------------------
# Source: ms-authentication .env — use the SAME values
# APEX validates tokens issued by ms-authentication using this shared secret.
# It does NOT talk to ms-authentication — just shares the secret.
JWT_SECRET=SuperSecretKeyForDevelopmentPurposesThatIsAtLeast32BytesLong!
JWT_ISSUER=http://localhost:5007
JWT_AUDIENCE=http://localhost:3000
